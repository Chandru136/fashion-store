# Database URL (PostgreSQL connection string)
DATABASE_URL="postgresql://postgres:your_url_encoded_password@localhost:5432/fashion_store?schema=public"

# Auth.js / NextAuth configuration
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
NEXTAUTH_URL="http://localhost:3000"

# Optional OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Payment configuration: RAZORPAY for test/live gateway; MOCK for local dummy payments
PAYMENT_PROVIDER="RAZORPAY"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Local dummy payments require PAYMENT_PROVIDER="MOCK" and this explicit opt-in.
# Always rejected when NODE_ENV=production. No API keys needed in MOCK mode.
ALLOW_MOCK_PAYMENTS="false"

# Email Notification Server Configuration
EMAIL_SERVER="smtp://smtp.example.com:5857"
EMAIL_FROM="orders@sudhacollections.com"

# Storage Configuration
STORAGE_BUCKET="sudha-collections-assets"
STORAGE_REGION="ap-south-1"


# Recovery worker / external scheduler authentication (random 32+ characters)
PAYMENT_CRON_SECRET=""
# Optional previous webhook secret during rotation
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=""

SMTP_USER=chandrur.skidc@srikrishna.ac.in
SMTP_PASSWORD=fhyb bluh ntva zwol
SMTP_FROM_NAME=Sudha Collections
ADMIN_NOTIFICATION_EMAIL=chandrur.skidc@srikrishna.ac.in
